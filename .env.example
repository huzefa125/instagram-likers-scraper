# Copy this file to .env and fill in real values. Never commit .env itself.

# Instagram session cookie (recommended login method - faster and less
# bot-detectable than driving the login form). Get it from Chrome DevTools:
# Application > Cookies > instagram.com > sessionid, while logged in.
IG_SESSIONID=

# Alternative to IG_SESSIONID: full username/password login.
# IG_LOGIN_USERNAME=
# IG_LOGIN_PASSWORD=

# Optional: additional named accounts, so many scrapes can run at once
# spread across many Instagram sessions instead of sharing (and
# rate-limiting/flagging) one. Name is arbitrary - matched case-insensitively
# against the IG_SESSIONID_<NAME> suffix. Add as many of these as you have
# session ids for (IG_SESSIONID_ACC1, ACC2, ACC3, ... ACC50, whatever naming
# you like). GET /accounts lists whichever names are set (never the values);
# GET /accounts/status shows which are currently busy/free.
#
# When any of these are set, POST /scrape and /scrape/bulk auto-assign a
# free account from this pool for any job that doesn't explicitly pass
# "account" - you normally don't need to pick one yourself. Falls back to
# the plain IG_SESSIONID above only when no named accounts are configured at
# all, or the pool is fully busy and nothing frees up within the wait.
# IG_SESSIONID_ACC1=
# IG_SESSIONID_ACC2=
# IG_SESSIONID_ACC3=

# Optional: cap on concurrent scrape jobs (each drives a real Chrome
# instance - RAM/CPU bound, not just account-count bound). Defaults to
# (number of configured named accounts + 1). Override this directly if your
# machine can't handle that many concurrent browsers, or can handle more.
# IG_MAX_CONCURRENT_JOBS=10

# MongoDB connection. Defaults shown are used if these are unset.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=big_insta_scrap
